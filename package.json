{
  "name": "qq-agent",
  "version": "0.5.2.4",
  "private": false,
  "description": "QQ 群 AI 机器人（桌面版）：事件驱动的无状态 Agent，接 OpenAI 兼容 API，带会话式控制台。",
  "type": "module",
  "main": "electron/main.js",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "start": "electron .",
    "server": "node src/server.js",
    "check": "node --test \"tests/*.test.mjs\"",
    "test": "pnpm run check",
    "build": "node scripts/prepack-check.mjs --win && node scripts/run-builder.mjs --win",
    "build:dir": "node scripts/prepack-check.mjs --win && node scripts/run-builder.mjs --win --dir",
    "build:mac": "node scripts/prepack-check.mjs --mac && node scripts/run-builder.mjs --mac",
    "build:mac:dir": "node scripts/prepack-check.mjs --mac && node scripts/run-builder.mjs --mac --dir",
    "build:linux": "node scripts/prepack-check.mjs --linux && node scripts/run-builder.mjs --linux",
    "build:linux:dir": "node scripts/prepack-check.mjs --linux && node scripts/run-builder.mjs --linux --dir",
    "prepack:check": "node scripts/prepack-check.mjs",
    "verify:version": "node scripts/verify-version.mjs"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "dependencies": {
    "js-yaml": "^5.4.1",
    "undici": "^6.28.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "license": "MIT",
  "author": "logan",
  "repository": {
    "type": "git",
    "url": "https://github.com/awsl1414/qq-agent.git"
  },
  "bugs": {
    "url": "https://github.com/awsl1414/qq-agent/issues"
  },
  "homepage": "https://github.com/awsl1414/qq-agent#readme"
}
